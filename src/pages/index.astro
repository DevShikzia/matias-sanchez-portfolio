---
import { getCollection } from 'astro:content';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hola, mi nombre es Matias Sanchez"
					tagline="Soy un desarrollador creativo que actualmente se encuentra en Buenos Aires, Argentina."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> Desarrollador web</Pill>
					</div>
				</Hero>

				<img
					alt="Matias Sanchez sonriendo con una remera negra y fondo blanco"
					width="480"
					height="620"
					src="/assets/matias-sanchez.png"
				/>
			</header>

			<section data-animate>
				<Skills />
			</section>
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta" data-animate>
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Proyectos Destacados</h3>
					<p>Vea abajo algunos de mis proyectos destacados</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project, index) => (
								<li data-animate data-animate-delay={(index % 4) + 1}>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta" data-animate data-animate-delay="2">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background bg-variant" data-animate>
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Experiencia y proyectos</h3>
					<p>
						He trabajado en el desarrollo de sistemas web, paneles de gestión y
						aplicaciones fullstack, enfocándome en backend, estructura y lógica de negocio.
					</p>
				</header>
			
				<div class="gallery">
					<Grid variant="small">
						{
							[
								'Sistema CRM con WhatsApp',
								'Gestión de turnos y citas',
								'Paneles administrativos',
								'APIs REST con Node.js',
								'Automatizaciones y procesos'
							].map((item, index) => (
								<li class="mention-card" data-animate="fade" data-animate-delay={(index % 4) + 1}>
									<p>{item}</p>
								</li>
							))
						}
					</Grid>
				</div>
			</section>
			
		</main>

		<section data-animate>
			<ContactCTA />
		</section>
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			/*gradiente radial muy suave y difuminado*/
			radial-gradient(ellipse at top center, 
				hsla(195, 45%, 95%, 0.05) 0%,
				hsla(195, 45%, 97%, 0.02) 40%,
				transparent 70%),
			var(--gray-999);
		background-blend-mode: overlay, normal, normal;
		mix-blend-mode: normal;
		z-index: -1;
	}

	.with-background.bg-variant::before {
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			/*gradiente radial variante muy suave*/
			radial-gradient(ellipse at center, 
				transparent 0%,
				hsla(195, 45%, 96%, 0.03) 50%,
				transparent 100%),
			var(--gray-999);
	}
	
	:root.theme-dark .with-background::before {
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			/*gradiente radial para dark mode muy suave*/
			radial-gradient(ellipse at top center, 
				transparent 0%,
				hsla(195, 45%, 10%, 0.08) 50%,
				transparent 80%),
			var(--gray-999);
	}
	
	:root.theme-dark .with-background.bg-variant::before {
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			/*gradiente radial variante dark mode muy suave*/
			radial-gradient(ellipse at center, 
				hsla(195, 45%, 8%, 0.06) 0%,
				transparent 60%),
			var(--gray-999);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
