---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Mis Proyectos | Matias Sanchez"
	description="Aprenda sobre los proyectos recientes de Matias Sanchez"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Mis Proyectos"
				tagline="Vea mis proyectos recientes abajo para obtener una idea de mi experiencia."
				align="start"
			/>
			<div class="notice">
				<p>🔧 <strong>Sección en construcción</strong> — Los proyectos se irán agregando próximamente con sus detalles completos.</p>
			</div>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.notice {
		background: var(--gray-999_40);
		border: 1px solid var(--accent-regular);
		border-radius: 0.75rem;
		padding: 1rem 1.5rem;
		text-align: center;
		color: var(--gray-200);
	}

	.notice strong {
		color: var(--accent-regular);
	}
</style>
